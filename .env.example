# Public origin of the storefront (used in metadata + Razorpay callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: point services/api/client.ts at a remote API. Leave blank for same-origin (default).
NEXT_PUBLIC_API_URL=

# Required. HMAC secret used to sign session JWTs. Generate a strong random value for production.
# Windows PowerShell: [Convert]::ToBase64String((1..48 | %{ Get-Random -Maximum 256 }))
AUTH_SECRET=change-me-to-a-long-random-string

# Razorpay (Phase 5). Sign up at https://dashboard.razorpay.com/ and use test keys during dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
