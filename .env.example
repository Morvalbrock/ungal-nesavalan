# =============================================================================
# Ungal Nesavalan — environment variables
# Copy this file to `.env.local` and fill in the values for your environment.
# Anything left blank falls back to the noted default (or a safe local stub).
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public origin of the storefront. Used for: canonical URLs, sitemap, robots,
# OpenGraph images, RSS, share links, Razorpay callbacks, and links in emails.
# Must be a full URL with protocol (e.g. https://ungalnesavalan.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Point services/api/client.ts at a remote API host.
# Leave blank for same-origin (default) — recommended.
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Authentication (required)
# -----------------------------------------------------------------------------
# HMAC secret used to sign session JWTs. Generate a strong random value for prod.
# Windows PowerShell: [Convert]::ToBase64String((1..48 | %{ Get-Random -Maximum 256 }))
# macOS/Linux:        openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Payments — Razorpay (Phase 5)
# -----------------------------------------------------------------------------
# Sign up at https://dashboard.razorpay.com/ and use test keys during dev.
# If RAZORPAY_KEY_ID or RAZORPAY_KEY_SECRET is missing, the app runs in
# simulate mode (no real charges). See docs/razorpay-testing.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID — needed on the client to open the checkout modal.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Used to verify signatures on incoming Razorpay webhooks. Set the same value
# in the Razorpay dashboard under Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------------
# Sign up at https://resend.com. If RESEND_API_KEY is missing, emails are
# logged to the server console instead of sent (safe for local dev).
RESEND_API_KEY=
# The From header on outgoing mail. Must be a domain you've verified in Resend.
# Format: "Display Name <address@your-domain.com>"
MAIL_FROM=Ungal Nesavalan <noreply@ungalnesavalan.example>

# -----------------------------------------------------------------------------
# Customer care
# -----------------------------------------------------------------------------
# Where /api/contact form submissions are delivered.
# Default: care@ungal-nesavalan.in
CONTACT_INBOX=

# Support email shown on invoices (PDF footer + email templates).
# Default: falls back to a placeholder — set this before going live.
SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# Order policies
# -----------------------------------------------------------------------------
# How many days after delivery a customer can raise a return request.
# Default: 7
RETURN_WINDOW_DAYS=7

# -----------------------------------------------------------------------------
# Cron jobs (abandoned-cart recovery)
# -----------------------------------------------------------------------------
# Required to authorize POST /api/cron/abandoned-carts.
# Send this in the Authorization header as: `Bearer <CRON_SECRET>`
# If unset, the endpoint refuses all requests (safe default).
CRON_SECRET=

# How many hours a cart must be idle before it triggers a recovery email.
# Default: 24
ABANDONED_CART_HOURS=24

# Optional coupon code embedded in the recovery email as an incentive.
# Leave blank to send without a coupon.
ABANDONED_CART_COUPON=

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# Plausible domain (e.g. "ungalnesavalan.com"). If unset, no tracker is loaded.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# -----------------------------------------------------------------------------
# Database — Neon Postgres (required in production)
# -----------------------------------------------------------------------------
# Full Postgres connection string. Neon dashboard → project → branch → Connection Details.
# If unset, the server falls back to file-based JSON storage under ./data
# (fine for local dev; fails on read-only hosts like Vercel).
DATABASE_URL=

# -----------------------------------------------------------------------------
# Uploads — Cloudinary (required in production)
# -----------------------------------------------------------------------------
# One combined env var: cloudinary://<api_key>:<api_secret>@<cloud_name>
# If unset, uploads fall back to writing under public/ (local dev only).
CLOUDINARY_URL=
